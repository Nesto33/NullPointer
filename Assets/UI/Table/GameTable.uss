/* Palette "Mystery Machine Glitch" — see LoginScreen.uss for the swatch. */

.table-root {
    flex-grow: 1;
    background-color: rgb(26, 17, 8);
}

.vignette-layer,
.scanlines,
.noise-layer,
.hud-layer,
.toast-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.scanlines {
    opacity: 0.5;
}

.noise-layer {
    opacity: 0.1;
}

.board-layout {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px;
}

.opponent-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: 150px;
}

.middle-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.opponent-col {
    width: 210px;
    height: 210px;
    align-items: center;
    justify-content: center;
}

.opponent-col--left {
    rotate: 90deg;
}

.opponent-col--right {
    rotate: -90deg;
}

.center-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.section-label {
    color: rgb(232, 163, 61);
    font-size: 14px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.player-label {
    color: rgb(245, 235, 216);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.card-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.card-row > * {
    margin-left: 6px;
    margin-right: 6px;
}

.card-row--local {
    margin-top: 4px;
}

.piles-row {
    flex-direction: row;
    margin-top: 40px;
}

.pile {
    align-items: center;
    margin-left: 30px;
    margin-right: 30px;
}

.pile-label {
    color: rgb(232, 163, 61);
    font-size: 12px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.card-slot {
    width: 70px;
    height: 100px;
    background-color: rgba(0, 0, 0, 0.4);
    -unity-background-scale-mode: scale-to-fit;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(232, 163, 61, 0.4);
    border-right-color: rgba(232, 163, 61, 0.4);
    border-top-color: rgba(232, 163, 61, 0.4);
    border-bottom-color: rgba(232, 163, 61, 0.4);
    transition-property: border-left-color, border-right-color, border-top-color, border-bottom-color, border-left-width, border-right-width, border-top-width, border-bottom-width, scale;
    transition-duration: 0.12s;
}

.card-slot--large {
    width: 150px;
    height: 210px;
    margin-top: 16px;
    margin-bottom: 16px;
}

.card-slot--clickable:hover {
    scale: 1.08 1.08;
}

.card-slot--targetable {
    border-left-color: rgb(193, 68, 14);
    border-right-color: rgb(193, 68, 14);
    border-top-color: rgb(193, 68, 14);
    border-bottom-color: rgb(193, 68, 14);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.card-slot--selectable {
    border-left-color: rgb(232, 163, 61);
    border-right-color: rgb(232, 163, 61);
    border-top-color: rgb(232, 163, 61);
    border-bottom-color: rgb(232, 163, 61);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.local-hand-container {
    align-items: center;
    margin-top: 10px;
}

.turn-indicator {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: rgba(20, 13, 6, 0.85);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(232, 163, 61);
    border-right-color: rgb(232, 163, 61);
    border-top-color: rgb(232, 163, 61);
    border-bottom-color: rgb(232, 163, 61);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 6px 12px;
}

.turn-indicator-label {
    color: rgb(140, 120, 100);
    font-size: 10px;
}

.turn-indicator-value {
    color: rgb(245, 235, 216);
    font-size: 16px;
    -unity-font-style: bold;
}

.shutdown-btn {
    position: absolute;
    bottom: 30px;
    right: 30px;
}

.toast-layer {
    align-items: center;
    justify-content: center;
}

.toast {
    background-color: rgba(20, 13, 6, 0.85);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(232, 163, 61);
    border-right-color: rgb(232, 163, 61);
    border-top-color: rgb(232, 163, 61);
    border-bottom-color: rgb(232, 163, 61);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 16px 26px;
    color: rgb(245, 235, 216);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pending-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(5, 3, 2, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.pending-card-panel {
    background-color: rgba(40, 27, 12, 0.95);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(232, 163, 61);
    border-right-color: rgb(232, 163, 61);
    border-top-color: rgb(232, 163, 61);
    border-bottom-color: rgb(232, 163, 61);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding: 30px;
    width: 420px;
    align-items: center;
}

.pending-instruction {
    color: rgb(245, 235, 216);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 16px;
    max-width: 320px;
}
